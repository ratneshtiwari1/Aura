# Copy to .env and populate Azure values. Never commit credentials.
USE_AI=true
AI_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AI_TIMEOUT_SECONDS=30
# Persistent storage; relative to the directory where you start the backend.
APP_DATA_DIR=./data
# Optional override; default is APP_DATA_DIR/sessions/<backend-session>/usage/token-usage.sqlite3
# TOKEN_USAGE_DB=./data/usage/token-usage.sqlite3
AUTH_REQUIRED=false
# For a shared deployment use AUTH_REQUIRED=true and real bearer tokens:
# AURA_API_TOKENS={"replace-with-secret-token":"user-id"}
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
